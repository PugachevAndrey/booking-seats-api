# Postgresql database connection
POSTGRES_USER=<Имя пользователя>
POSTGRES_PASSWORD=<Пароль пользователя>
POSTGRES_DB=<Название базы данных>
POSTGRES_SERVER=<Название или IP сервера базы данных>
POSTGRES_PORT=<Порт базы данных>
SECRET_KEY=<Секретный ключ>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RabbitMQ (Celery broker)
RABBITMQ_USER=<Имя пользователя RabbitMQ>
RABBITMQ_PASSWORD=<Пароль RabbitMQ>
RABBITMQ_HOST=<Название или IP сервера RabbitMQ>
RABBITMQ_PORT=5672

# SMS provider (опционально)
SMS_API_KEY=<API ключ SMS-провайдера>
SMS_SENDER=<Имя отправителя>

# SMTP (email)
SMTP_HOST=<SMTP сервер>
SMTP_PORT=587
SMTP_USER=<SMTP пользователь>
SMTP_PASSWORD=<SMTP пароль>

# Telegram bot
TELEGRAM_BOT_TOKEN=<Токен Telegram-бота>